# --- STAGE 1: Build & Dependencies ---
FROM node:20-alpine AS builder
WORKDIR /usr/src/app

# Copy dependency manifests first to leverage Docker layer caching
COPY package*.json ./

# Install all dependencies (including devDependencies for building/testing)
RUN npm ci

# Copy the rest of the application source code
COPY . .

# Optional: Run a build step if you are using TypeScript or a bundler
# RUN npm run build


# --- STAGE 2: Production Runtime ---
FROM node:20-alpine AS runner
WORKDIR /usr/src/app

# Enforce production environment for performance optimizations
ENV NODE_ENV=production

# Copy manifests to track production-only installations
COPY package*.json ./

# Install ONLY production dependencies and clear npm cache to keep image small
RUN npm ci --omit=dev && npm cache clean --force

# Copy application source (or compiled /dist folder) from the builder stage
COPY --from=builder /usr/src/app .

# Security: Switch from root to the pre-configured 'node' user
USER node

# Document the port Express runs on
EXPOSE 3000

# Start app using 'node', avoiding npm wrappers to properly pass OS signals
CMD ["node", "index.js"]